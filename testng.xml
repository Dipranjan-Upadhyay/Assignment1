<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Flipkart Automation Suite" verbose="1">

    <listeners>
        <listener class-name="com.flipkart.listeners.TestListener"/>
        <listener class-name="com.flipkart.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Flipkart Login Flow">
        <classes>
            <class name="com.flipkart.tests.LoginTest"/>
        </classes>
    </test>
</suite>
